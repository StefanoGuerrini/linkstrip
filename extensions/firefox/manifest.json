{
  "manifest_version": 2,
  "name": "LinkStrip",
  "version": "1.4.1",
  "default_locale": "en",
  "description": "Remove tracking parameters from links. Privacy-first, offline, and open source.",
  "homepage_url": "https://stefanoguerrini.dev/linkstrip/",
  "developer": {
    "name": "Stefano Guerrini",
    "url": "https://github.com/StefanoGuerrini/linkstrip"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "linkstrip@stefanoguerrini.dev",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": ["cleaner.js", "background.js"],
    "persistent": false
  },
  "permissions": [
    "contextMenus",
    "clipboardWrite",
    "notifications"
  ],
  "web_accessible_resources": [
    "tracking-params.json"
  ]
}
